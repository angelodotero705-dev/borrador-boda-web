const DATA={
  names:"Eder & Mayra",
  dateISO:"2026-11-07T08:30:00",
  dateText:"07 · 11 · 2026",
  place:"san Agustin de cajas · Huancayo · Perú",
  quote:"“Nos uniremos en matrimonio y será una gran alegía com partir este momento tan especial con ustedes.”",

  groomParents:"Esequiel Canteño Justiniano<br>Luisa Adriana Yupanqui viuda de Canteño",
  brideParents:"Serapio Lucio Nuñez Solano<br>Ada Frida Cuyutupac Chipana",
  godparents:"Edwin Francisco Onofre Aquino<br>&amp; Hada Solano Cáceres",

  church:{
    name:"Parroquia San Agusitn de Hipona",
    date:"07 de noviembre · 08:30 p.m.",
    maps:"https://maps.app.goo.gl/KiAXq5hPDMDRZy528"
  },
  reception:{
    name:"Local “El Paraíso”",
    date:"Después de la ceremonia",
    maps:"https://maps.app.goo.gl/bsUc3NRpXJLssnd69"
  },

  /* Coloca aquí tus fotos. Deben estar dentro de assets/ */
  photos:[
    "assets/foto1.svg","assets/foto2.svg","assets/foto3.svg",
    "assets/foto4.svg","assets/foto5.svg","assets/foto6.svg",
    "assets/foto7.svg","assets/foto8.svg","assets/foto9.svg"
  ],

  /* Si quieres confirmación por WhatsApp, cambia el número.
     Formato Perú: 519XXXXXXXX */
  whatsapp:"51999999999"
};
/* ===================================================== */

const set=(id,value)=>{const e=document.getElementById(id); if(e)e.innerHTML=value};
["openNames","names","storyNames","footerNames"].forEach(id=>set(id,DATA.names));
["openDate","date","storyDate"].forEach(id=>set(id,DATA.dateText));
set("place",DATA.place);set("storyPlace",DATA.place);
set("quote",DATA.quote);set("groomParents",DATA.groomParents);
set("brideParents",DATA.brideParents);set("godparents",DATA.godparents);
set("churchName",DATA.church.name);set("churchDate",DATA.church.date);
set("churchAddress",DATA.church.address);set("churchMap",`<a href="${DATA.church.maps}" target="_blank">Ver en Google Maps ↗</a>`);
set("receptionName",DATA.reception.name);set("receptionDate",DATA.reception.date);
set("receptionAddress",DATA.reception.address);set("receptionMap",`<a href="${DATA.reception.maps}" target="_blank">Ver en Google Maps ↗</a>`);
set("footerDate",`${DATA.dateText} — ${DATA.place}`);

const gallery=document.getElementById("gallery");
DATA.photos.forEach((src,i)=>{
  const img=document.createElement("img"); img.src=src; img.alt=`James & Delicia — Foto ${i+1}`; img.loading="lazy";
  img.addEventListener("click",()=>openPhoto(i)); gallery.appendChild(img);
});

let current=0;
const lb=document.getElementById("lightbox"), lbImg=document.getElementById("lightboxImg");
function openPhoto(i){current=i;lbImg.src=DATA.photos[current];document.getElementById("photoCounter").textContent=`${current+1} / ${DATA.photos.length}`;lb.classList.add("open")}
function move(n){current=(current+n+DATA.photos.length)%DATA.photos.length;lbImg.src=DATA.photos[current];document.getElementById("photoCounter").textContent=`${current+1} / ${DATA.photos.length}`}
document.getElementById("closeLightbox").onclick=()=>lb.classList.remove("open");
document.getElementById("prevPhoto").onclick=()=>move(-1);document.getElementById("nextPhoto").onclick=()=>move(1);
lb.addEventListener("click",e=>{if(e.target===lb)lb.classList.remove("open")});
document.addEventListener("keydown",e=>{if(e.key==="Escape")lb.classList.remove("open");if(e.key==="ArrowLeft")move(-1);if(e.key==="ArrowRight")move(1)});

document.getElementById("openBtn").onclick=()=>{
  document.getElementById("preloader").classList.add("hide");
  document.getElementById("site").classList.remove("site-hidden");
  document.body.style.overflow="auto";
  setTimeout(()=>document.querySelectorAll(".reveal").forEach(e=>e.classList.add("visible")),150);
  window.scrollTo(0,0);
};
document.body.style.overflow="hidden";

const target=new Date(DATA.dateISO).getTime();
function countdown(){
 const d=Math.max(0,target-Date.now());
 document.getElementById("days").textContent=String(Math.floor(d/86400000)).padStart(2,"0");
 document.getElementById("hours").textContent=String(Math.floor(d/3600000)%24).padStart(2,"0");
 document.getElementById("minutes").textContent=String(Math.floor(d/60000)%60).padStart(2,"0");
 document.getElementById("seconds").textContent=String(Math.floor(d/1000)%60).padStart(2,"0");
}
countdown();setInterval(countdown,1000);

const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add("visible")}),{threshold:.12});
document.querySelectorAll(".reveal").forEach(e=>observer.observe(e));

document.getElementById("rsvp").addEventListener("submit",e=>{
 e.preventDefault();
 const name=document.getElementById("guest").value.trim();
 const attendance=document.getElementById("attendance").value;
 const people=document.getElementById("people").value;
 const msg=`Hola, somos invitados a la boda de ${DATA.names}.%0A%0ANombre: ${name}%0AAsistencia: ${attendance}%0APersonas: ${people}`;
 const url=`https://wa.me/${DATA.whatsapp}?text=${msg}`;
 window.open(url,"_blank");
});
*{box-sizing:border-box}
:root{--cream:#f6f0e9;--paper:#fffdfa;--ink:#4a3c35;--soft:#806e62;--gold:#a78970;--line:#ddd0c4;--dark:#2d2521}
html{scroll-behavior:smooth}
body{margin:0;background:var(--cream);color:var(--ink);font-family:Montserrat,sans-serif;font-weight:300;line-height:1.8}
h1,h2,h3{font-family:"Cormorant Garamond",serif;font-weight:500;line-height:1.05}
h2{font-size:clamp(2.6rem,6vw,4.8rem);margin:12px 0}
p{margin:8px 0}.muted{color:var(--soft);font-size:.88rem}.kicker{font-size:.65rem;letter-spacing:.28em;text-transform:uppercase;color:var(--gold)}
button{font-family:inherit;cursor:pointer}
.site-hidden{display:none}

/* Apertura */
#preloader{position:fixed;inset:0;z-index:100;background:linear-gradient(135deg,#eee2d7,#faf7f2);display:grid;place-items:center;text-align:center;padding:25px;transition:opacity .9s,visibility .9s}
#preloader.hide{opacity:0;visibility:hidden}
#preloader h1{font-size:clamp(3.5rem,10vw,6.5rem);margin:5px 0 10px}
#preloader p{margin:0}.envelope{width:125px;height:92px;border:1px solid #c8b3a2;position:relative;margin:0 auto 20px;background:#fdfaf6;box-shadow:0 15px 40px #6d574020}
.envelope:after{content:"";position:absolute;inset:0;background:linear-gradient(145deg,transparent 49%,#dbc9b9 50%,transparent 51%),linear-gradient(215deg,transparent 49%,#dbc9b9 50%,transparent 51%)}
.wax{position:absolute;z-index:2;left:50%;top:50%;transform:translate(-50%,-50%);width:48px;height:48px;border-radius:50%;background:#8e6854;color:white;display:grid;place-items:center;font:600 12px Georgia;box-shadow:0 3px 10px #0002}
#openBtn{margin-top:28px;padding:13px 28px;background:transparent;border:1px solid var(--gold);color:var(--ink);letter-spacing:.12em;text-transform:uppercase;font-size:.68rem}

/* Hero */
.hero{height:100vh;min-height:650px;position:relative;display:grid;place-items:center;text-align:center;color:white;background:url("assets/hero.svg") center/cover fixed}
.hero-shade{position:absolute;inset:0;background:linear-gradient(#0002,#0006)}
.hero-content{position:relative;z-index:2}.hero .kicker{color:#eee}
.hero h1{font-size:clamp(4.2rem,13vw,9rem);margin:15px 0 8px;text-shadow:0 2px 20px #0005}
.hero p{font-size:1rem;letter-spacing:.12em}.ornament{font-size:1.4rem;margin:12px}.scroll{position:absolute;bottom:25px;z-index:2;font-size:.6rem;letter-spacing:.25em}.scroll span{display:block;font-size:1rem}

/* Secciones */
.paper{background:var(--paper)}
.story{text-align:center;padding:110px 25px}
.story .quote{max-width:650px;margin:28px auto;font:italic 1.55rem/1.6 "Cormorant Garamond",serif}
.line{height:1px;width:65px;background:var(--gold);margin:28px auto}
.parents{text-align:center;padding:100px 25px}
.inner{max-width:1050px;margin:auto}.parent-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;margin:55px 0 25px}
.parent-grid article{padding:15px 25px;border-left:1px solid var(--line)}
.parent-grid article:last-child{border-right:1px solid var(--line)}
.parent-grid span{font-size:.62rem;letter-spacing:.18em;color:var(--gold)}
.parent-grid h3{font-size:1.65rem;font-weight:400}
.count{text-align:center;padding:110px 25px;background:#efe6dd}
.count>p{max-width:650px;margin:auto}.timer{display:flex;justify-content:center;gap:14px;margin-top:45px;flex-wrap:wrap}
.timer div{width:110px;padding:18px 8px;border:1px solid #cdbbaa;background:#f9f4ee}
.timer b{display:block;font:500 3.1rem/1 "Cormorant Garamond",serif}.timer small{font-size:.58rem;letter-spacing:.15em;text-transform:uppercase}
.events{text-align:center;padding:110px 25px}.intro{max-width:650px;margin:auto}
.event-grid{max-width:1000px;margin:55px auto 0;display:grid;grid-template-columns:1fr 1fr;gap:25px}
.event{padding:45px 35px;border:1px solid var(--line);background:#fff}
.event-icon{font:2.5rem Georgia;color:var(--gold);margin-bottom:15px}.event h3{font-size:2.35rem;margin:12px 0}.event a{display:inline-block;margin-top:10px;color:var(--ink);font-size:.72rem;letter-spacing:.08em;text-decoration:none;border-bottom:1px solid var(--gold)}
.gallery{text-align:center;padding:110px 25px;max-width:1100px;margin:auto}
.gallery>p{max-width:650px;margin:auto}.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:50px}
.gallery-grid img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;cursor:pointer;transition:.4s;filter:saturate(.8)}.gallery-grid img:hover{filter:saturate(1);transform:scale(1.015)}
.rsvp{max-width:850px;margin:auto;text-align:center;padding:110px 25px}.rsvp form{max-width:520px;margin:35px auto 0;display:grid;gap:14px}.rsvp input,.rsvp select{padding:16px;border:1px solid var(--line);background:white;color:var(--ink);font:inherit;outline:none}.rsvp button{padding:16px;background:var(--dark);color:white;border:0;letter-spacing:.12em;text-transform:uppercase;font-size:.65rem}.rsvp button:hover{background:#55443a}
footer{text-align:center;background:var(--dark);color:white;padding:75px 25px}footer .kicker{color:#cdb39f}footer h2{font-size:3.8rem;margin:12px 0}footer p{color:#cbbdb3;font-size:.75rem;letter-spacing:.1em}

/* Lightbox */
.lightbox{display:none;position:fixed;z-index:200;inset:0;background:#17120fe8;align-items:center;justify-content:center;padding:60px}
.lightbox.open{display:flex}.lightbox img{max-width:min(850px,90vw);max-height:80vh;object-fit:contain}
.lightbox button{position:absolute;background:transparent;border:0;color:white;font-size:3rem;font-family:Georgia}
#closeLightbox{right:25px;top:15px}.lightbox #prevPhoto{left:25px}.lightbox #nextPhoto{right:25px}
#photoCounter{position:absolute;bottom:20px;color:white;font-size:.7rem;letter-spacing:.2em}

/* Animaciones */
.reveal{opacity:0;transform:translateY(30px);transition:1s ease}.reveal.visible{opacity:1;transform:none}
@media(max-width:700px){
 .hero{background-attachment:scroll;min-height:700px}.parent-grid,.event-grid{grid-template-columns:1fr}.parent-grid article{border-left:0;border-bottom:1px solid var(--line);padding-bottom:25px}.parent-grid article:last-child{border-right:0;border-bottom:0}.gallery-grid{grid-template-columns:repeat(2,1fr)}.timer div{width:100px}.lightbox{padding:45px 15px}
}

